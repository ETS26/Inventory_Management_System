@model Inventory_Management.WebUI.Models.LoginViewModel

@{
    Layout = null; // Login sayfasında menü/footer olmasın
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giriş Yap - InventoryPro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        }

        .btn-primary {
            background-color: #0d6efd;
            padding: 10px;
            font-weight: 600;
        }

        .brand-logo {
            color: #0d6efd;
            font-size: 2rem;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="card login-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="brand-logo fw-bold">
                <i class="fas fa-shopping-cart me-2"></i>InventoryPro
            </div>
            <h5 class="text-muted fw-normal">Hesabınıza giriş yapın</h5>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Auth" asp-action="Login" method="post">

            <div class="form-floating mb-3">
                <input asp-for="Email" type="email" class="form-control" id="emailInput" placeholder="name@example.com">
                <label for="emailInput">Email adresi</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="Password">
                <label for="passwordInput">Şifre</label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                    <i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
                </button>
            </div>
        </form>

    </div>

</body>
</html>